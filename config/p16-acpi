#!/usr/bin/env bash
build() {
    [[ $KERNELVERSION == 7.2.8-14-omarchy-p16 || $KERNELVERSION == 7.2.8-14-omarchy-p16-asus || $KERNELVERSION == 7.2.8-23-omarchy-p16-asus || $KERNELVERSION == 7.2.8-24-omarchy-p16-asus || $KERNELVERSION == 7.2.8-25-omarchy-p16-asus || $KERNELVERSION == 7.2.8-23-omarchy-p16-asus-npu2 || $KERNELVERSION == 7.2.8-23-rtx-spark-npu ]] || {
        error 'P16 ACPI override requires the dedicated kernel allocation fix'
        return 1
    }
    add_file_early /etc/initcpio/p16-acpi/SSDT.aml /kernel/firmware/acpi/SSDT.aml
}
help() {
    echo 'Hash-validated H7607BA.300 ASUS EC/battery fix, for the dedicated P16 kernel only.'
}
