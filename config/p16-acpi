#!/usr/bin/env bash
build() {
    [[ $KERNELVERSION == *-omarchy-p16 || $KERNELVERSION == *-omarchy-p16-asus* || $KERNELVERSION == *-rtx-spark-npu ]] || {
        error 'P16 ACPI override requires the dedicated kernel allocation fix'
        return 1
    }
    add_file_early /etc/initcpio/p16-acpi/DSDT.aml /kernel/firmware/acpi/DSDT.aml
    add_file_early /etc/initcpio/p16-acpi/SSDT.aml /kernel/firmware/acpi/SSDT.aml
}
help() {
    echo 'Hash-validated H7607BA.300 SSPM and EC/battery fixes, for the dedicated P16 kernel only.'
}
