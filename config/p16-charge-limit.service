[Unit]
Description=Apply P16 battery charge limit (80 percent)
After=systemd-udev-trigger.service p16-asus-controls.service
Wants=p16-asus-controls.service
ConditionKernelVersion=|*-omarchy-p16-asus*
ConditionKernelVersion=|*-rtx-spark-npu

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/p16-charge-limit
RemainAfterExit=yes
TimeoutStartSec=20

[Install]
WantedBy=multi-user.target
