[Unit]
Description=Apply P16 battery charge limit (80 percent)
After=systemd-udev-trigger.service p16-asus-controls.service
Wants=p16-asus-controls.service
ConditionKernelVersion=|7.2.8-14-omarchy-p16-asus
ConditionKernelVersion=|7.2.8-23-omarchy-p16-asus
ConditionKernelVersion=|7.2.8-24-omarchy-p16-asus
ConditionKernelVersion=|7.2.8-25-omarchy-p16-asus
ConditionKernelVersion=|7.3.0-26-omarchy-p16-asus
ConditionKernelVersion=|7.2.8-23-omarchy-p16-asus-npu2
ConditionKernelVersion=|7.2.8-23-rtx-spark-npu

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/p16-charge-limit
RemainAfterExit=yes
TimeoutStartSec=20

[Install]
WantedBy=multi-user.target
